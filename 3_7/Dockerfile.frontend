FROM node:16-alpine

WORKDIR /usr/src/app

COPY --chown=appuser:appuser code/example-frontend .

ENV REACT_APP_BACKEND_URL=http://localhost:8080/

RUN addgroup -S appuser && adduser -S appuser -G appuser && \
    chown -R appuser:appuser /usr/src/app && \
    npm install && \
    npm run build && \
    npm install -g serve && \
    rm -rf src

USER appuser

EXPOSE 5001

CMD ["serve", "-s", "-l", "5001", "build"]
